# Server
PORT=5000
NODE_ENV=development
# Base URL for uploaded images. In production set to: https://api.drneerajkumarneurologist.com
API_IMAGE_URL=http://localhost:5000
CLIENT_URL=http://localhost:3000,https://drneerajkumarneurologist.com,https://www.drneerajkumarneurologist.com
ADMIN_URL=http://localhost:3001,https://admin.drneerajkumarneurologist.com

# MySQL (Production: AWS RDS / DigitalOcean / cPanel / MariaDB)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=neurocare_db
DB_SSL=false

# Redis (Set CACHE_ENABLED=false if no Redis is installed on production)
REDIS_URL=redis://127.0.0.1:6379
CACHE_ENABLED=true
CACHE_TTL=300
CACHE_PREFIX=neurocare

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=30d
ADMIN_JWT_SECRET=your_admin_jwt_secret_key_here
ADMIN_JWT_EXPIRES_IN=7d

# Cofounder secret key
COFOUNDER_SECRET_KEY=ffac91a027c9ea9ba08c80cb2b33ce42d1dff4dfadcde7eb7df560243c9c6562

# Cloudinary (Optional - auto falls back to local disk storage if not set)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Razorpay
RAZORPAY_KEY_ID=rzp_live_xxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# SMS / OTP provider
OTP_PROVIDER=console
OTP_API_KEY=
OTP_SENDER_ID=APP
OTP_EXPIRY_MINUTES=5

# WhatsApp Provider (Optional)
WAPP_API_URL=
WAPP_API_TOKEN=
WAPP_ADMIN_PHONE_NUMBER=
WAPP_COUNTRY=IN
BRAND_NAME="Dr Neeraj Kumar Neurologist"

# Email (Nodemailer SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=neurocareclinic@gmail.com
SMTP_PASS=app_password_here
SMTP_FROM="Neurocare Clinic <neurocareclinic@gmail.com>"

# Admin bootstrap (used by seed)
ADMIN_EMAIL=admin@neurocareclinic.in
ADMIN_PASSWORD=Admin@12345
