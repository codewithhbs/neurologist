# Server
PORT=5000
# Base URL put in front of stored image paths in API responses (no trailing slash).
# Local: http://localhost:5000  |  Live: https://api.yourdomain.com
API_IMAGE_URL=http://localhost:5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# MySQL (XAMPP)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=neurocare_db

# Redis (XAMPP local redis / standalone)
REDIS_URL=redis://127.0.0.1:6379

# Redis response cache
# CACHE_ENABLED=false  -> bypass cache entirely (every request hits MySQL)
# CACHE_TTL            -> default seconds a cached response lives (routes override this)
# CACHE_PREFIX         -> key namespace; keeps cache keys separate from otp:* keys
CACHE_ENABLED=true
CACHE_TTL=300
CACHE_PREFIX=neurocare

# JWT
JWT_SECRET=eqiouweuioweiodkjdkjhdshjkldjhkdhuiewuireyuiewrhjkdffdjbfdjhfauifrjhk
JWT_EXPIRES_IN=30d
ADMIN_JWT_SECRET=gdjhdhuiewyuiwejhdshuilweqiyuweqJHSDAHJSDYUIWEHIUDENBDHUILHUIDNDDEIHUDEOIEWQExhldsnjkcdhewdhldcnkdsjhbd
ADMIN_JWT_EXPIRES_IN=7d

# Cloudinary (OPTIONAL — leave blank/placeholder to auto-fallback to local disk storage at /uploads,
# served from this server at {SERVER_URL}/uploads/<folder>/<filename>)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Razorpay
RAZORPAY_KEY_ID=rzp_test_T8XbqaXF6Hu9ea
RAZORPAY_KEY_SECRET=5y3UNgaiOM2QtEGdYSeF2jyC

# SMS/OTP provider (plug in MSG91 / Twilio / Fast2SMS)
OTP_PROVIDER=console
OTP_API_KEY=
OTP_SENDER_ID=APP
OTP_EXPIRY_MINUTES=5

# Email (Nodemailer SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=neurocareclinic@gmail.com
SMTP_PASS=app_password_here
SMTP_FROM="Neurocare Clinic <neurocareclinic@gmail.com>"

# Admin bootstrap (used only by seed)
ADMIN_EMAIL=admin@neurocareclinic.in
ADMIN_PASSWORD=Admin@12345
